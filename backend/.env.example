# ==============================================================
# Quivers Backend Environment Variables Example
# NEVER commit your actual .env file or hardcode API keys!
# ==============================================================

# Anthropic Claude API Key (Called only from backend)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Credentials (PostgreSQL database & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Optional: Path to Tesseract OCR executable if not in system PATH (Windows default example)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
