# ==============================================================
# Quivers Backend Environment Variables Example
# NEVER commit your actual .env file or hardcode API keys!
# ==============================================================

# Anthropic Claude API Key (Called only from backend)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Credentials (PostgreSQL database & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Supabase JWT secret for fast offline token validation (Found in Supabase API settings)
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Optional: Path to Tesseract OCR executable if not in system PATH (Windows default example)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
